#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#

set -e

APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if command -v gradle >/dev/null 2>&1 && [ ! -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
    exec gradle "$@"
fi

if [ ! -f "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" ]; then
    echo "gradle-wrapper.jar is missing and Gradle is not installed." >&2
    echo "Install Gradle 8.14+ and run: gradle wrapper --gradle-version 8.14" >&2
    exit 1
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=gradlew" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
